# Supabase — create a project at https://supabase.com and paste your credentials below.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Moolre payment gateway (Phase 5). MOOLRE_API_USER/MOOLRE_API_KEY are sent as
# the X-API-USER/X-API-PUBKEY headers docs.moolre.com requires.
MOOLRE_API_USER=
MOOLRE_API_KEY=
MOOLRE_ACCOUNT_ID=
MOOLRE_WEBHOOK_SECRET=

# International card payments (Stripe) — placeholders, add real test/live
# keys from your Stripe dashboard when ready. Ghana checkout uses Moolre
# above and never touches this.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@kysneakers.com

# Transactional SMS (Hubtel)
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=KYSneakers

# Google OAuth (configured in Supabase Auth providers, not read directly by the app)
